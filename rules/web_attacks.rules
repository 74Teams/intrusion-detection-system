# WEB ATTACKS DETECTION RULES
# Format: alert [proto] [src_ip] [src_port] -> [dst_ip] [dst_port] (options)

# --- 1. SQL INJECTION (SQLi) ---
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - UNION SELECT detected"; http_uri; content:"union"; nocase; content:"select"; nocase; sid:1000001; rev:1; classtype:web-application-attack; severity:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - Classic OR boolean bypass"; http_uri; content:"or"; nocase; pcre:"/or\s+['"]?\d+['"]?\s*=\s*['"]?\d+/i"; sid:1000002; rev:1; classtype:web-application-attack; severity:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK SQL Injection - SQL comment execution (--)"; http_uri; content:"--"; sid:1000003; rev:1; classtype:web-application-attack; severity:2;)

# --- 2. CROSS-SITE SCRIPTING (XSS) ---
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - SCRIPT tag attempt"; http_uri; content:"<script"; nocase; sid:1000010; rev:1; classtype:web-application-attack; severity:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - Javascript URI handler"; http_uri; content:"javascript:"; nocase; sid:1000011; rev:1; classtype:web-application-attack; severity:2;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Cross-Site Scripting - Event handler payload"; http_client_body; pcre:"/on(error|load|mouseover)\s*=/i"; sid:1000012; rev:1; classtype:web-application-attack; severity:1;)

# --- 3. PATH TRAVERSAL / LFI ---
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Path Traversal - Directory traversal attempt (../)"; http_uri; content:"../"; sid:1000020; rev:1; classtype:attempted-recon; severity:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Sensitive File Access - /etc/passwd access attempt"; http_uri; content:"/etc/passwd"; sid:1000021; rev:1; classtype:attempted-admin; severity:1;)
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Sensitive File Access - Windows win.ini access"; http_uri; content:"win.ini"; nocase; sid:1000022; rev:1; classtype:attempted-admin; severity:1;)

# --- 4. COMMAND INJECTION (RCE) ---
alert tcp any any -> any $HTTP_PORTS (msg:"WEB-ATTACK Command Injection - Chained commands execution"; http_uri; pcre:"/(\|\s*id|;\s*cat\s+|&\s*whoami)/i"; sid:1000030; rev:1; classtype:web-application-attack; severity:1;)
